# Copia este archivo a .env.local y rellena los valores (NO subas .env.local a git)

# --- IA: "google" (Gemini) o "bedrock" (Claude en Amazon Bedrock) ---
AI_PROVIDER=google

# Gemini: AI Studio > Claves de API > Crear clave de API (empieza por AIza...)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Bedrock (cuenta del hackathon). Comprobad en la consola de Bedrock el ID exacto
# del modelo habilitado (puede requerir prefijo de inference profile, p.ej. "eu.")
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# --- Supabase ---
# URL del proyecto: https://<project-ref>.supabase.co  (botón "Connect" o Settings > General > Project ID)
NEXT_PUBLIC_SUPABASE_URL=
# Settings > API Keys > Publishable key (empieza por sb_publishable_). Se puede usar en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Settings > API Keys > Secret keys (empieza por sb_secret_). SOLO servidor, nunca en código cliente.
SUPABASE_SECRET_KEY=
