# Copia este archivo a .env.local y rellena los valores (NO subas .env.local a git)

# --- IA ---
# auto   = Bedrock (si hay credenciales AWS) y, si falla o caduca, Gemini
# google = solo Gemini (para no gastar crédito de AWS)
AI_PROVIDER=auto

# Gemini: AI Studio > Claves de API > Crear clave de API (empieza por AIza...)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Si el principal falla (saturado, sin cuota o colgado) se prueban estos, en orden
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Segundos máximos de espera por modelo antes de pasar al siguiente
AI_TIMEOUT_S=30

# Modelos elegidos con `npm run benchmark` (rapidez + calidad del semáforo):
#   Claude Sonnet 5.5 → Gemini 3.5 Flash Lite → Gemini 3.1 Flash Lite
# Bedrock (credenciales TEMPORALES del workshop). Para obtenerlas, en la terminal
# del workshop: aws configure export-credentials --format env
# Comprobar que siguen vivas: npm run ia:check
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# --- Supabase ---
# URL del proyecto: https://<project-ref>.supabase.co  (botón "Connect" o Settings > General > Project ID)
NEXT_PUBLIC_SUPABASE_URL=
# Settings > API Keys > Publishable key (empieza por sb_publishable_). Se puede usar en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Settings > API Keys > Secret keys (empieza por sb_secret_). SOLO servidor, nunca en código cliente.
SUPABASE_SECRET_KEY=
